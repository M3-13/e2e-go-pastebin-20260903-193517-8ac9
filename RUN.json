{
  "runcontract": 1,
  "services": [
    {
      "name": "pastebin",
      "dir": ".",
      "stack": "go",
      "kind": "server",
      "build": [["go", "build", "-o", "pastebin", "."]],
      "start": ["./pastebin"],
      "port": 8080,
      "port_env": "PORT",
      "health": { "path": "/health", "expect_status": [200] },
      "env": {
        "PORT": { "dev": "8080" }
      }
    }
  ]
}
